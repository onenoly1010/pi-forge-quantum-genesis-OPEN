FROM python:3.11-slim-bullseye AS builder

WORKDIR /app
RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

COPY server/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

FROM python:3.11-slim-bullseye
WORKDIR /app

RUN groupadd -r forge && useradd -r -g forge forge
RUN chown -R forge:forge /app

COPY --from=builder /opt/venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

COPY server/fastapi_app /app/fastapi_app

# Health endpoint
RUN echo 'from fastapi import FastAPI, Response\napp = FastAPI()\n@app.get("/health")\ndef health(): return {"status": "healthy"}\n@app.get("/ready")\ndef ready(): return {"status": "ready"}' > /app/health.py

USER forge
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/health')"

CMD ["uvicorn", "fastapi_app.main:app", "--host", "0.0.0.0", "--port", "8000"]
